# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Database ---
EMPLOYEE_SERVICE_DB_ENGINE=django.db.backends.postgresql
EMPLOYEE_SERVICE_DB_NAME=employee_service
EMPLOYEE_SERVICE_DB_USER=employee_service
EMPLOYEE_SERVICE_DB_PASSWORD=<new strong password, not the one that was in git>
EMPLOYEE_SERVICE_DB_HOST=host.docker.internal
EMPLOYEE_SERVICE_DB_PORT=5432

# --- Django ---
EMPLOYEE_SERVICE_TIME_ZONE=Asia/Tashkent
# Production: false. With false the service refuses to start on placeholder secrets below.
EMPLOYEE_SERVICE_DEBUG=false
PUBLIC_BASE_URL=https://192.168.101.6
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.101.6
# >= 40 random characters. It signs bnpzID login codes: whoever knows it can forge a login.
SECRET_KEY=<secrets.token_urlsafe(64)>

# --- Integration with other systems (TB project) ---
# Service key(s) for TB / ppe_product, comma separated, >= 32 characters. TB reads AND writes with it
# (employee sync with photos, departments, sections). Put the same value into TB's .env as
# EMPLOYEE_SERVICE_API_KEY. Without DEBUG there is no default key: if this line is empty, every TB request gets 403.
EMPLOYEE_SERVICE_API_KEYS=<secrets.token_urlsafe(48)>
# bnpzID clients (or manage them in the admin panel: BnpzIdClient). client_secret >= 32 characters.
BNPZID_CLIENTS={"tb-project": {"name": "TB project", "client_secret": "<secrets.token_urlsafe(48)>", "access_check_url": "https://192.168.101.6:8050/api/v1/users/bnpzid/access-check/", "allowed_redirects": ["https://192.168.101.6:6060/auth/signin"]}}
# TB's access-check uses a self-signed certificate: point to its CA instead of turning verification off.
# BNPZID_ACCESS_CHECK_CA_BUNDLE=/app/certs/tb-ca.crt
# BNPZID_ACCESS_CHECK_VERIFY_SSL=true
# Extra browser origins allowed to call the API with cookies (comma separated).
# CORS_EXTRA_ORIGINS=

# --- Hardening (defaults shown; change only with a reason) ---
# SECURE_COOKIES=true                 # cookies only over HTTPS (default: on when DEBUG is off)
# SESSION_COOKIE_AGE_SECONDS=43200    # 12 hours
# SESSION_COOKIE_NAME=sessionid       # e.g. es_sessionid so other apps on this host do not get/override it
# MEDIA_REQUIRE_AUTH=false            # true = photos only for logged-in users / the service key; breaks TB photos today
# LOGIN_FAILURE_LIMIT=5               # wrong passwords per login+IP before a 15 min lock
# LOGIN_IP_FAILURE_LIMIT=30
# LOGIN_LOCKOUT_SECONDS=900
# FACE_LOGIN_MAX_ATTEMPTS=5
# FACE_LOGIN_PENDING_TTL_SECONDS=300
# FACE_THROTTLE_RATE=30/min
# Timekeeper API for other systems (API_TIMEKEEPER.md)
# TIMEKEEPER_API_TOKEN_TTL_HOURS=24   # how long a token lives
# TIMEKEEPER_API_MAX_TOKENS=5         # active tokens per timekeeper (the oldest is replaced)
# TIMEKEEPER_TOKEN_THROTTLE_RATE=10/min   # token requests per client IP
# TIMEKEEPER_API_THROTTLE_RATE=120/min    # API calls per timekeeper
# SECURE_HSTS_SECONDS=0               # enable (e.g. 31536000) only with a certificate browsers trust
